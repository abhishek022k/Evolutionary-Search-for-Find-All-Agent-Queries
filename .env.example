# Copy to .env and fill in. .env is gitignored; this file is not.
# label.py and run_evolution.py both read these names.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: only needed if your key belongs to a specific workspace.
ANTHROPIC_WORKSPACE_ID=
# Optional: only for the Gemini annotator in label.py.
GEMINI_API_KEY=
